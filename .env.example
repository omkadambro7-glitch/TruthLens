# TruthLens Environment Variables
PROJECT_NAME=TruthLens
API_V1_STR=/api/v1
SECRET_KEY=change_this_to_a_secure_random_string_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (Defaults to SQLite for instant local zero-dependency setup)
DATABASE_URL=sqlite+aiosqlite:///./truthlens.db
# For PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/truthlens

# Storage Paths
UPLOAD_DIR=./storage/uploads
ARTIFACTS_DIR=./storage/artifacts

# Upload Limits
MAX_IMAGE_BYTES=15728640
MAX_DOC_BYTES=26214400

# CORS Origins (Comma-separated)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
